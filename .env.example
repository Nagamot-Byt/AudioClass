# ============================================================
# AudioClass Transcription Server - Variables de entorno
#
# Copia este archivo a .env y personaliza los valores:
#   cp .env.example .env
#
# Luego ejecuta:
#   docker-compose -f docker-compose.server.yml up -d
# ============================================================

# ── Servidor ──────────────────────────────────────────────
# Puerto del servidor (default: 8000)
AUDIOCLASS_PORT=8000

# API Key para autenticación (dejar vacío para acceso abierto)
# Recomendado para producción: generar con openssl rand -hex 32
AUDIOCLASS_API_KEY=

# Límite de subida en MB (default: 200)
AUDIOCLASS_MAX_UPLOAD_MB=200

# Rate limit por minuto (default: 30)
AUDIOCLASS_RATE_LIMIT=30

# ── Transcripción ─────────────────────────────────────────
# Modelo de Whisper: tiny, base, small, medium, large
AUDIOCLASS_MODEL=base

# Idioma: auto, es, en, pt, fr, de, etc.
AUDIOCLASS_LANGUAGE=auto

# Dispositivo: cpu, cuda, mps
AUDIOCLASS_DEVICE=cpu

# ── Inteligencia Artificial (opcional) ─────────────────────
# Google Gemini API Key (gratis en aistudio.google.com)
GEMINI_API_KEY=

# OpenAI API Key (plan gratuito disponible)
OPENAI_API_KEY=

# ── Docker Compose profiles ────────────────────────────────
# Profiles disponibles:
#   - (default): Solo servidor de transcripción
#   - proxy: Agrega nginx reverse proxy
#   - monitoring: Agrega Prometheus + Grafana
#
# Uso:
#   docker-compose -f docker-compose.server.yml up -d
#   docker-compose -f docker-compose.server.yml --profile proxy up -d
#   docker-compose -f docker-compose.server.yml --profile monitoring up -d

# ── Grafana (solo con profile monitoring) ──────────────────
GRAFANA_PASSWORD=admin
