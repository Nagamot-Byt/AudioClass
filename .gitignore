# ── Binarios y builds (pesados, no versionar) ──
*.exe
*.zip
*.pt
dist/
build/
build_onefile/
dist_onefile/

# ── Modelos de whisper (se descargan en CI, se empaquetan en el exe) ──
models/
models_ct2/

# ── Audios y bases de datos locales ──
demo_audio/
*.wav
# Excepciones: fixtures de VOZ REAL para los tests (estrés, streaming,
# benchmark) y el CI. Sin ellos, un clone limpio no puede correr esos tests.
!prueba_voz_es.wav
!tts_clase.wav
.freebuff/
*.db
*.db-shm
*.db-wal

# ── Versiones antiguas del proyecto (solo la v9.1 vigente) ──
3 Versión/
First Version/
Second Version/
"AudioClass (1).spec"
"AudioClass (2).spec"

# ── Secrets por variables de entorno (red de seguridad: la app guarda las
# claves cifradas con DPAPI en audioclass_config.json, no en .env, pero si
# alguien introduce un .env, que JAMAS se suba al repo) ──
.env
.env.*
!.env.example

# ── Artefactos y temporales ──
*.log
*_smoke_out.txt
selftest_*.txt
*.bak
__pycache__/
*.pyc
.venv/
venv/
# Configs temporales de los validadores (se regeneran al ejecutar) y
# salidas de tests/benchmark
_smoke_config.json
_micwarn_exe_config.json
_wcag_config.json
_wcag_exe_config.json
benchmark_results.json

# ── Scratch de diagnóstico (nunca versionar) ──
_captura_*
_e2e_*
_diag_*
_geom_*
_capturas_*
